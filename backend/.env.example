# Copy to .env and load explicitly; Spring Boot does not auto-load .env files.
# Only enable real model assembly when you need it.
SPRING_PROFILES_ACTIVE=llm
LLM_API_KEY=replace-with-your-api-key
# Include the API version path, for example /v1; omit /chat/completions.
LLM_BASE_URL=https://api.example.com/v1
LLM_MODEL=replace-with-your-model-id
LLM_TIMEOUT=45s
# For models requiring max_completion_tokens, use the Spring property instead.
LLM_MAX_TOKENS=2048
AGENT_MAX_ITERATIONS=12
AGENT_RUN_TIMEOUT=120s
AGENT_TOOL_TIMEOUT=15s
