# Dev overrides: copy to .env. Values are literal; no shell expansion.
DB_PORT=15432
DB_NAME=loopcraft_local
DB_USER=loopcraft
DB_PASSWORD=loopcraft_local_only
SERVER_PORT=8080
FRONTEND_PORT=5173
# Optional logging overrides; defaults to .run/logs under the repository.
# LOG_DIR=/absolute/path/to/logs
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_APP=INFO

# 首次空库初始化管理员，成功后关闭并移除密码。
BOOTSTRAP_ADMIN_ENABLED=false
# BOOTSTRAP_ADMIN_USERNAME=admin
# BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-private-password
